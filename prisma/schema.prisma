generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ASUN_ADMIN
  AGENCY_ADMIN
  RMA
  CASE_OFFICER
  FINANCE
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ConsentStatus {
  SIGNED
  PENDING
  EXPIRED
}

enum ConflictCheckStatus {
  CLEAR
  ESCALATE
  DECLINED
}

enum MatterStage {
  INTAKE
  DOCUMENTS
  LODGEMENT
  CASE_OFFICER_REQUEST
  DECISION
  ARCHIVED
}

enum TaskStatus {
  OPEN
  BLOCKED
  DONE
  SNOOZED
}

enum ChecklistStatus {
  REQUESTED
  RECEIVED
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  REQUESTED
  RECEIVED
  VERIFIED
  REJECTED
  SIGNING
}

enum InvoiceStatus {
  DRAFT
  SENT
  OVERDUE
  PAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WorkflowItemType {
  TASK
  CHECKLIST
}

enum MessageVisibility {
  INTERNAL
  EXTERNAL
}

model Tenant {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  brandColor      String             @default("#47624f")
  retentionYears  Int                @default(7)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  users           User[]
  clients         Client[]
  familyLinks     FamilyLink[]
  matters         Matter[]
  keyDates        MatterKeyDate[]
  tasks           Task[]
  checklistItems  ChecklistItem[]
  documents       Document[]
  envelopes       SignatureEnvelope[]
  invoices        Invoice[]
  payments        Payment[]
  messages        Message[]
  workflowTemplates WorkflowTemplate[]
  auditEvents     AuditEvent[]
}

model User {
  id                    String       @id @default(uuid())
  tenantId              String
  name                  String
  email                 String
  role                  Role
  status                UserStatus   @default(ACTIVE)
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTasks         Task[]       @relation("TaskAssignee")
  primaryAgentMatters   Matter[]     @relation("MatterPrimaryAgent")
  caseOfficerMatters    Matter[]     @relation("MatterCaseOfficer")
  uploadedDocuments     Document[]   @relation("DocumentUploader")
  verifiedDocuments     Document[]   @relation("DocumentVerifier")
  verifiedChecklistItems ChecklistItem[] @relation("ChecklistVerifier")
  sentMessages          Message[]
  auditEvents           AuditEvent[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Client {
  id                  String              @id @default(uuid())
  tenantId            String
  name                String
  email               String
  dateOfBirth         DateTime
  nationality         String
  passportEncrypted   String
  passportMasked      String
  consentStatus       ConsentStatus       @default(PENDING)
  conflictCheckStatus ConflictCheckStatus @default(ESCALATE)
  portalActive        Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matters             Matter[]
  invoices            Invoice[]
  primaryFamilyLinks  FamilyLink[]        @relation("PrimaryClient")
  dependantFamilyLinks FamilyLink[]       @relation("DependantClient")

  @@unique([tenantId, email])
  @@index([tenantId, name])
}

model FamilyLink {
  id                 String @id @default(uuid())
  tenantId           String
  primaryClientId    String
  dependantClientId  String
  relationship       String
  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryClient      Client @relation("PrimaryClient", fields: [primaryClientId], references: [id], onDelete: Cascade)
  dependantClient    Client @relation("DependantClient", fields: [dependantClientId], references: [id], onDelete: Cascade)

  @@unique([primaryClientId, dependantClientId])
}

model Matter {
  id              String           @id @default(uuid())
  tenantId        String
  clientId        String
  visaSubclass    String
  title           String
  stage           MatterStage      @default(INTAKE)
  trn             String?
  primaryAgentId  String?
  caseOfficerId   String?
  openedAt        DateTime         @default(now())
  closedAt        DateTime?
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  primaryAgent    User?            @relation("MatterPrimaryAgent", fields: [primaryAgentId], references: [id])
  caseOfficer     User?            @relation("MatterCaseOfficer", fields: [caseOfficerId], references: [id])
  keyDates        MatterKeyDate[]
  tasks           Task[]
  checklistItems  ChecklistItem[]
  documents       Document[]
  invoices        Invoice[]
  messages        Message[]

  @@index([tenantId, stage])
  @@index([tenantId, visaSubclass])
}

model MatterKeyDate {
  id              String   @id @default(uuid())
  tenantId        String
  matterId        String
  type            String
  label           String
  date            DateTime
  alertBeforeDays Int      @default(30)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter          Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
}

model Task {
  id          String     @id @default(uuid())
  tenantId    String
  matterId    String
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  dueOn       DateTime
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter      Matter     @relation(fields: [matterId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, dueOn])
}

model ChecklistItem {
  id           String          @id @default(uuid())
  tenantId     String
  matterId     String
  title        String
  category     String
  status       ChecklistStatus @default(REQUESTED)
  required     Boolean         @default(true)
  dueOn        DateTime?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter       Matter          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  verifiedBy   User?           @relation("ChecklistVerifier", fields: [verifiedById], references: [id])
  documents    Document[]

  @@index([tenantId, status])
}

model Document {
  id              String              @id @default(uuid())
  tenantId        String
  matterId        String
  checklistItemId String?
  title           String
  fileName        String
  fileType        String
  fileSize        Int
  storageKey      String
  status          DocumentStatus      @default(RECEIVED)
  uploadedById    String?
  verifiedById    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter          Matter              @relation(fields: [matterId], references: [id], onDelete: Cascade)
  checklistItem   ChecklistItem?      @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  uploadedBy      User?               @relation("DocumentUploader", fields: [uploadedById], references: [id])
  verifiedBy      User?               @relation("DocumentVerifier", fields: [verifiedById], references: [id])
  envelopes       SignatureEnvelope[]

  @@index([tenantId, status])
}

model SignatureEnvelope {
  id                 String    @id @default(uuid())
  tenantId           String
  documentId         String
  provider           String    @default("docusign")
  providerEnvelopeId String
  status             String
  sentAt             DateTime  @default(now())
  completedAt        DateTime?
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document           Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String        @id @default(uuid())
  tenantId  String
  matterId  String
  clientId  String
  number    String
  status    InvoiceStatus @default(DRAFT)
  subtotal  Decimal       @db.Decimal(12, 2)
  tax       Decimal       @db.Decimal(12, 2)
  total     Decimal       @db.Decimal(12, 2)
  dueOn     DateTime
  sentAt    DateTime?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter    Matter        @relation(fields: [matterId], references: [id], onDelete: Cascade)
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model Payment {
  id                String        @id @default(uuid())
  tenantId          String
  invoiceId         String
  provider          String        @default("stripe")
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Message {
  id         String            @id @default(uuid())
  tenantId   String
  matterId   String
  senderId   String?
  visibility MessageVisibility @default(EXTERNAL)
  body       String
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter     Matter            @relation(fields: [matterId], references: [id], onDelete: Cascade)
  sender     User?             @relation(fields: [senderId], references: [id])

  @@index([tenantId, createdAt])
}

model WorkflowTemplate {
  id           String                 @id @default(uuid())
  tenantId     String
  visaSubclass String
  name         String
  description  String?
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        WorkflowTemplateItem[]

  @@unique([tenantId, visaSubclass, name])
}

model WorkflowTemplateItem {
  id            String           @id @default(uuid())
  templateId    String
  type          WorkflowItemType
  title         String
  description   String?
  stage         MatterStage
  dueOffsetDays Int
  required      Boolean          @default(true)
  template      WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

